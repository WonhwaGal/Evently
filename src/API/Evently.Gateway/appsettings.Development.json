{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedOrigins": "http://localhost:3000",
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File",
            "Serilog.Sinks.Seq"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "/logs/Evently.log",
                    "rollingInterval": "Day"
                }
            },
            {
                "Name": "Seq",
                "Args": { "serverUrl": "http://evently.seq:5341" }
            }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
        "Properties": {
            "Application": "Evently.Api"
        }
    },
    "Authentication": {
        "Audience": "account",
        "TokenValidationParameters": {
            "ValidIssuers": [ "http://evently.identity:8080/realms/evently", "http://localhost:18080/realms/evently" ]
        },
        "MetadataAddress": "http://evently.idp:8080/realms/evently/.well-known/openid-configuration",
        "RequireHttpsMetadata": false
    },
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://evently.jaeger:4317", // tells open telemetry where to send data
    "ReverseProxy": {
        "Routes": {
            "evently-route1": {
                "ClusterId": "evently-cluster",
                "AuthorizationPolicy": "default",
                "Match": {
                    "Path": "{**catch-all}"
                }
            },
            "evently-route2": {
                "ClusterId": "evently-cluster",
                "AuthorizationPolicy": "anonymous",
                "Match": {
                    "Path": "users/register"
                }
            },
            "evently-route3": {
                "ClusterId": "evently-cluster",
                "AuthorizationPolicy": "anonymous",
                "Match": {
                    "Path": "users/login"
                }
            },
            "evently-route4": {
                "ClusterId": "evently-cluster",
                "AuthorizationPolicy": "anonymous",
                "Match": {
                    "Path": "categories"
                }
            },
            "evently-route5": {
                "ClusterId": "evently-cluster",
                "AuthorizationPolicy": "anonymous",
                "Match": {
                    "Path": "categories/create" // {**rest} - matches anything under /categories/*"
                }
            },
            "evently-ticketing-route1": {
                "ClusterId": "evently-ticketing-cluster",
                "AuthorizationPolicy": "default",
                "Match": {
                    "Path": "tickets/{**catch-all}"
                },
                "Transforms": [ { "PathPattern": "tickets/{**catch-all}" } ]
            }
        },
        "Clusters": {
            "evently-cluster": {
                "Destinations": {
                    "destination1": {
                        "Address": "http://evently.api:8080"
                    }
                }
            },
            "evently-ticketing-cluster": {
                "Destinations": {
                    "destination1": {
                        "Address": "http://evently.ticketing.api:8080"
                    }
                }
            }
        }
    }
}
