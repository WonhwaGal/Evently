root = true

# C# файлы
[*.cs]

#### Основные опции EditorConfig ####

# Отступы и пробелы
indent_size = 4
indent_style = space
tab_width = 4

# Предпочтения для новой строки
end_of_line = crlf
insert_final_newline = true

#### Конвенции кодирования .NET ####

# Организация using
dotnet_separate_import_directive_groups = false
dotnet_sort_system_directives_first = true

# Предпочтения для this. и Me.
dotnet_style_qualification_for_event = false:error
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_qualification_for_property = false:error

# Предпочтения для ключевых слов языка против типов BCL
dotnet_style_predefined_type_for_locals_parameters_members = true:error
dotnet_style_predefined_type_for_member_access = true:error

# Предпочтения для скобок
dotnet_style_parentheses_in_arithmetic_binary_operators = never_if_unnecessary:error
dotnet_style_parentheses_in_other_binary_operators = never_if_unnecessary:error
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:error
dotnet_style_parentheses_in_relational_binary_operators = never_if_unnecessary:error

# Предпочтения для модификаторов
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error

# Предпочтения на уровне выражений
dotnet_style_coalesce_expression = true:none
dotnet_style_collection_initializer = true:error
dotnet_style_explicit_tuple_names = true:error
dotnet_style_null_propagation = true:error
dotnet_style_object_initializer = true:error
dotnet_style_prefer_auto_properties = true:warning
dotnet_style_prefer_compound_assignment = true:error
dotnet_style_prefer_conditional_expression_over_assignment = true:error
dotnet_style_prefer_conditional_expression_over_return = true:none
dotnet_style_prefer_inferred_anonymous_type_member_names = true:error
dotnet_style_prefer_inferred_tuple_names = true:error
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:error
csharp_indent_labels = one_less_than_current
csharp_using_directive_placement = outside_namespace:error
csharp_prefer_simple_using_statement = true:error
csharp_prefer_braces = true:error
csharp_style_namespace_declarations = file_scoped:error
csharp_style_prefer_method_group_conversion = true:silent
csharp_style_prefer_top_level_statements = true:silent
csharp_style_prefer_primary_constructors = true:none
csharp_style_expression_bodied_methods = false:silent
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_operators = true:error
csharp_style_expression_bodied_properties = true:error
csharp_style_expression_bodied_indexers = true:error
csharp_style_expression_bodied_accessors = true:error
csharp_style_expression_bodied_lambdas = true:error
csharp_style_expression_bodied_local_functions = true:error

[*.{cs,vb}]
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion
dotnet_style_prefer_simplified_interpolation = true:suggestion
dotnet_style_namespace_match_folder = true:suggestion

# Предпочтения для полей
dotnet_style_readonly_field = true:error

# Предпочтения для параметров
dotnet_code_quality_unused_parameters = all:error

#### Конвенции кодирования C# ####

# Предпочтения для пространства имен
csharp_style_namespace_declarations= file_scoped:error

# Предпочтения для var
csharp_style_var_elsewhere = false:error
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = true:error

# Члены выражения
csharp_style_expression_bodied_accessors = true:error
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_indexers = true:error
csharp_style_expression_bodied_lambdas = true:none
csharp_style_expression_bodied_local_functions = true:error
csharp_style_expression_bodied_methods = false:silent
csharp_style_expression_bodied_operators = true:error
csharp_style_expression_bodied_properties = true:error

# Предпочтения для сопоставления с образцом
csharp_style_pattern_matching_over_as_with_null_check = true:error
csharp_style_pattern_matching_over_is_with_cast_check = true:error
csharp_style_prefer_switch_expression = true:error

# Предпочтения для проверки на null
csharp_style_conditional_delegate_call = true:error

# Предпочтения для модификаторов
csharp_prefer_static_local_function = true:error
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async

# Предпочтения для блоков кода
csharp_prefer_braces = true:error
csharp_prefer_simple_using_statement = true:error

# Предпочтения на уровне выражений
csharp_prefer_simple_default_expression = true:error
csharp_style_deconstructed_variable_declaration = true:suggestion
csharp_style_inlined_variable_declaration = true:error
csharp_style_pattern_local_over_anonymous_function = true:error
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_unused_value_assignment_preference = discard_variable:silent
csharp_style_unused_value_expression_statement_preference = discard_variable:none
csharp_style_prefer_method_group_conversion = true:silent
csharp_style_prefer_top_level_statements = true:silent

# Предпочтения для директив 'using'
csharp_using_directive_placement = outside_namespace:error

#### Правила форматирования C# ####

# Предпочтения для новой строки
csharp_new_line_before_catch =true
csharp_new_line_before_else =true
csharp_new_line_before_finally =true
csharp_new_line_before_members_in_anonymous_types = false
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_open_brace = all
csharp_new_line_between_query_expression_clauses = true

# Предпочтения для отступов
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_labels = one_less_than_current
csharp_indent_switch_labels = true

# Предпочтения для пробелов
csharp_space_after_cast = false
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_semicolon_in_for_statement = true
csharp_space_around_binary_operators = before_and_after
csharp_space_around_declaration_statements = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_before_comma = false
csharp_space_before_dot = false
csharp_space_before_open_square_brackets = false
csharp_space_before_semicolon_in_for_statement = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_between_square_brackets = false

# Предпочтения для переноса
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false

#### Стили именования ####

# Правила именования

dotnet_naming_rule.interface_should_be_begins_with_i.severity = suggestion
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i

dotnet_naming_rule.types_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.non_field_members_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.non_field_members_should_be_pascal_case.symbols = non_field_members
dotnet_naming_rule.non_field_members_should_be_pascal_case.style = pascal_case

# Спецификации символов

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.interface.required_modifiers =

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum
dotnet_naming_symbols.types.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.types.required_modifiers =

dotnet_naming_symbols.non_field_members.applicable_kinds = property, event, method
dotnet_naming_symbols.non_field_members.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.non_field_members.required_modifiers =

# Стили именования

dotnet_naming_style.pascal_case.required_prefix =
dotnet_naming_style.pascal_case.required_suffix =
dotnet_naming_style.pascal_case.word_separator =
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.required_suffix =
dotnet_naming_style.begins_with_i.word_separator =
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# Пользовательские правила - настройте их по мере необходимости

# Правила анализатора кода .NET

# CA1000: Не объявляйте статические члены в обобщенных типах
dotnet_diagnostic.CA1000.severity = none

# CA1002: Не выставляйте обобщенные списки
dotnet_diagnostic.CA1002.severity = none

# CA1008: Перечисления должны иметь нулевое значение
dotnet_diagnostic.CA1008.severity = none

# CA1019: Определите аксессоры для аргументов атрибутов
dotnet_diagnostic.CA1019.severity = none

# CA1024: Используйте свойства, где это уместно
dotnet_diagnostic.CA1024.severity = none

# CA1030: Используйте события, где это уместно
dotnet_diagnostic.CA1030.severity = none

# CA1031: Не ловите общие типы исключений
dotnet_diagnostic.CA1031.severity = none

# CA1032: Реализуйте стандартные конструкторы исключений
dotnet_diagnostic.CA1032.severity = none

# CA1034: Вложенные типы не должны быть видимыми
dotnet_diagnostic.CA1034.severity = none

# CA1040: Избегайте пустых интерфейсов
dotnet_diagnostic.CA1040.severity = none

# CA1051: Не объявляйте видимые поля экземпляра
dotnet_diagnostic.CA1051.severity = none

# CA1056: Свойства, похожие на URI, не должны быть строками
dotnet_diagnostic.CA1056.severity = none

# CA1062: Проверяйте аргументы общедоступных методов
dotnet_diagnostic.CA1062.severity = none

# CA1063: Правильно реализуйте IDisposable
dotnet_diagnostic.CA1063.severity = none

# CA1307: Укажите StringComparison для ясности
dotnet_diagnostic.CA1307.severity = none

# CA1308: Нормализуйте строки в верхний регистр
dotnet_diagnostic.CA1308.severity = none

# CA1700: Не называйте значения перечислений 'Reserved'
dotnet_diagnostic.CA1700.severity = none

# CA1707: Идентификаторы не должны содержать подчеркивания
dotnet_diagnostic.CA1707.severity = none

# CA1711: Идентификаторы не должны иметь неправильный суффикс
dotnet_diagnostic.CA1711.severity = none

# CA1716: Идентификаторы не должны совпадать с ключевыми словами
dotnet_diagnostic.CA1716.severity = none

# CA1724: Имена типов не должны совпадать с пространствами имен
dotnet_diagnostic.CA1724.severity = none

# CA1812: Избегайте неинициализированных внутренних классов
dotnet_diagnostic.CA1812.severity = none

# CA1816: Методы Dispose должны вызывать SuppressFinalize
dotnet_diagnostic.CA1816.severity = none

# CA1819: Свойства не должны возвращать массивы
dotnet_diagnostic.CA1819.severity = none

# CA1822: Отметьте члены как статические
dotnet_diagnostic.CA1822.severity = none

# CA1848: Используйте делегаты LoggerMessage
dotnet_diagnostic.CA1848.severity = none

# CA1860: Избегайте использования метода расширения 'Enumerable.Any()'
dotnet_diagnostic.CA1860.severity = none

# CA2007: Рассмотрите возможность вызова ConfigureAwait на ожидаемой задаче
dotnet_diagnostic.CA2007.severity = none

# CA2201: Не поднимайте зарезервированные типы исключений
dotnet_diagnostic.CA2201.severity = none

# CA2211: Необязательные поля не должны быть видимыми
dotnet_diagnostic.CA2211.severity = none

# CA2213: Поля, подлежащие уничтожению, должны быть уничтожены
dotnet_diagnostic.CA2213.severity = none

# CA2225: У операторов перегрузки должны быть именованные альтернативы
dotnet_diagnostic.CA2225.severity = none

# CA2227: Свойства коллекций должны быть только для чтения
dotnet_diagnostic.CA2227.severity = none

# CA2234: Передавайте объекты системного URI вместо строк
dotnet_diagnostic.CA2234.severity = none

# CA2326: Не используйте значения TypeNameHandling, отличные от None
dotnet_diagnostic.CA2326.severity = none

# CA2326: Не используйте небезопасные JsonSerializerSettings
dotnet_diagnostic.CA2327.severity = none

# CS8600: Преобразование нулевого литерала или возможного нулевого значения в не допускающий null тип.
dotnet_diagnostic.CS8600.severity = none

# CS8603: Возможный возврат ссылки на null.
dotnet_diagnostic.CS8603.severity = none

# CS8618: Не допускающее null поле должно содержать не допускающее null значение при выходе из конструктора. Рассмотрите возможность объявления как допускающего null.
dotnet_diagnostic.CS8618.severity = none

# Правила анализатора кода IDE

# IDE0046: Преобразовать в условное выражение
dotnet_diagnostic.IDE0046.severity = none

# IDE0053: Используйте тело выражения для лямбда-выражения
dotnet_diagnostic.IDE0053.severity = none

# IDE0270: Используйте выражение слияния
dotnet_diagnostic.IDE0270.severity = none

# IDE0290: Используйте основной конструктор
dotnet_diagnostic.IDE0290.severity = none

# Правила SonarAnalyzer.CSharp

# S112: Общие или зарезервированные исключения никогда не должны выбрасываться
dotnet_diagnostic.S112.severity = none

# S1075: URI не должны быть зашиты в код
dotnet_diagnostic.S1075.severity = none

# S2094: Утилитарные классы не должны иметь общедоступных конструкторов
dotnet_diagnostic.S1118.severity = none

# S1144: Неиспользуемые приватные типы или члены должны быть удалены
dotnet_diagnostic.S1144.severity = none

# S2094: Классы не должны быть пустыми
dotnet_diagnostic.S2094.severity = none

# S2365: Свойства не должны создавать копии коллекций или массивов
dotnet_diagnostic.S2365.severity = none

# S3267: Циклы должны быть упрощены с помощью выражений "LINQ"
dotnet_diagnostic.S3267.severity = none

# S3881: "IDisposable" должен быть правильно реализован
dotnet_diagnostic.S3881.severity = none

# S4136: Перегрузки методов должны быть сгруппированы вместе
dotnet_diagnostic.S4136.severity = none

# S125: Наличие комментариев внутри кода
dotnet_diagnostic.S125.severity = none

# S6605: Должен использоваться специфический для коллекции метод "Exists" вместо расширения "Any"
dotnet_diagnostic.S6605.severity = none

[*.{cs,vb}]
dotnet_diagnostic.IDE0055.severity = none
[*.{cs,vb}]
dotnet_diagnostic.IDE0022.severity = none
[*.{cs,vb}]
dotnet_diagnostic.IDE0305.severity = none
[*.{cs,vb}]
dotnet_diagnostic.IDE0072.severity = none
[*.{cs,vb}]
dotnet_diagnostic.IDE0060.severity = none
[*.{cs,vb}]
dotnet_diagnostic.IDE0061.severity = none
[*.{cs,vb}]
dotnet_diagnostic.CA1515.severity = none


